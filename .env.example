# Optional: enables Groq-powered intent parsing and AI interpretation.
# Without it, WebPilot AI uses deterministic rule-based parsing.
GROQ_API_KEY=
# Any currently supported Groq chat model id (check console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
